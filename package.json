{
  "name": "jgroup-bank-id-components",
  "version": "0.0.1",
  "description": "Stencil web component for Swedish BankID authentication/signing flows",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/jgroup-bank-id-components/jgroup-bank-id-components.esm.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/janjoo-group/bank-id-components.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
